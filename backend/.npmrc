# Render builds run with NODE_ENV=production, which makes npm omit
# devDependencies — and TypeScript (the build-time compiler) lives there by
# design (DEC: devDeps for dev-only tooling). Without this line the deploy
# prunes tsc and `npm run build` dies with "'tsc' is not recognized".
# include=dev forces dev deps in every install regardless of NODE_ENV;
# runtime is unaffected (no installs run after the build).
include=dev
