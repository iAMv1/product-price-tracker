# Backend env — copy to .env for local dev. Production sets these in Render.
PORT=4000
STORE_URL=https://demo.inelabteamdev.com
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
CRON_SECRET=<long-random-token>
CORS_ORIGINS=http://localhost:5173
# User auth (Supabase Auth: email + Google). Unset = open dev mode.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Optional bonus hooks (alerts keep working in-app without these):
# SENDGRID_API_KEY=<sendgrid-key>
# ALERT_TO=<notify-email>
