# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
# Empty is allowed in development; production boot refuses to start without it.
DATABASE_URL=

# Shared secret the external scheduler must present as "Authorization: Bearer <value>"
# on /api/internal/* endpoints.
CRON_SECRET=dev-cron-secret

# INE mock store origin.
STORE_URL=https://demo.inelabteamdev.com

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173
