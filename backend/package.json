{
  "name": "@ppt/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Product Price Tracker backend API, scrape orchestrator and scraper engine",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "headed:scrape": "tsx tools/headed-scrape.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "pg-mem": "^3.0.14",
    "playwright": "^1.63.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
