# Production build wiring (loaded by Vite whenever mode=production).
# VITE_API_BASE_URL must be absolute in production: a bare relative fetch
# resolves against the Vercel host, which has no API routes -> 404 on every
# endpoint. The backend URL is public (README), not a secret. Local dev is
# unaffected (mode=development uses the vite proxy -> http://localhost:4000).
VITE_API_BASE_URL=https://ppt-backend-lyiv.onrender.com
