# Copy to .env for local overrides. In development Vite proxies /api and /health
# to the backend, so these are usually only needed in production.

# Public URL of the deployed backend. Leave empty to use the dev proxy.
VITE_API_BASE_URL=

# Only read by vite.config.ts to retarget the dev proxy.
VITE_BACKEND_ORIGIN=http://localhost:4000
