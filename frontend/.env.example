# Frontend env — copy to .env for local dev. Production sets VITE_API_BASE_URL in Vercel.
VITE_API_BASE_URL=
VITE_BACKEND_ORIGIN=http://localhost:4000
# Login UI (Supabase Auth). Unset = dashboard reads work, writes need backend open mode.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
